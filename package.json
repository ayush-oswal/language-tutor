{
  "name": "language-tutor-mcp",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate -w @lt/db",
    "db:generate": "npm run generate -w @lt/db",
    "build": "npm run build -w @lt/db && npm run build -w @lt/core && npm run build -w @lt/api && npm run build -w @lt/mcp",
    "dev:api": "npm run dev -w @lt/api",
    "dev:mcp": "npm run dev -w @lt/mcp",
    "dev:web": "npm run dev -w apps/web",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  }
}
