datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum CEFRLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PRONOUN
  PREPOSITION
  CONJUNCTION
  INTERJECTION
  DETERMINER
  NUMERAL
  PHRASE
}

enum WordStatus {
  NEW
  LEARNING
  FAMILIAR
  MASTERED
}

enum ExerciseType {
  NEW_WORD_LEARNING
  MATCHING
  MULTIPLE_CHOICE
  TRANSLATION
  FILL_BLANK
  STORY
}

enum ExerciseStatus {
  NEW
  IN_PROGRESS
  COMPLETED
}

model User {
  id          String   @id @default(uuid())
  clerkUserId String   @unique
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions    LanguageSession[]
}

/// Shared, seeded catalogue — not owned by any user.
model Language {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  words     Word[]
  sessions  LanguageSession[]
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique

  words Word[]
}

model Word {
  id             String       @id @default(cuid())
  languageId     String
  word           String
  normalizedWord String
  translation    String
  partOfSpeech   PartOfSpeech
  level          CEFRLevel
  gender         String?
  /// Frequency rank within the language (1 = most common); lower ranks are introduced first.
  rank           Int?
  /// Example usages: [{ "sentence": string, "translation": string }]
  sentences      Json         @default("[]")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  language       Language       @relation(fields: [languageId], references: [id], onDelete: Cascade)
  tags           Tag[]
  progress       WordProgress[]

  @@unique([languageId, normalizedWord, partOfSpeech])
  @@index([languageId, level])
}

/// A user's enrollment in a language, at the level they are currently studying.
model LanguageSession {
  id           String    @id @default(uuid())
  userId       String
  languageId   String
  currentLevel CEFRLevel
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  language     Language       @relation(fields: [languageId], references: [id], onDelete: Cascade)
  wordProgress WordProgress[]
  exercises    Exercise[]

  @@unique([userId, languageId])
  @@index([userId])
}

model WordProgress {
  id                String     @id @default(cuid())
  languageSessionId String
  wordId            String
  status            WordStatus @default(NEW)
  mastery           Float      @default(0)
  timesSeen         Int        @default(0)
  timesCorrect      Int        @default(0)
  timesWrong        Int        @default(0)
  lastSeenAt        DateTime?
  nextReviewAt      DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  session           LanguageSession @relation(fields: [languageSessionId], references: [id], onDelete: Cascade)
  word              Word            @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([languageSessionId, wordId])
  @@index([languageSessionId, status])
  @@index([languageSessionId, nextReviewAt])
  @@index([wordId])
}

model Exercise {
  id                String         @id @default(cuid())
  languageSessionId String
  type              ExerciseType
  status            ExerciseStatus @default(NEW)
  payload           Json
  answerKey         Json
  generationContext Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  completedAt       DateTime?

  session           LanguageSession   @relation(fields: [languageSessionId], references: [id], onDelete: Cascade)
  attempts          ExerciseAttempt[]

  @@index([languageSessionId, status])
  @@index([languageSessionId, type])
  @@index([languageSessionId, createdAt])
}

model ExerciseAttempt {
  id              String    @id @default(cuid())
  exerciseId      String
  answers         Json
  score           Int
  percentage      Float
  questionResults Json
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  exercise        Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
}
